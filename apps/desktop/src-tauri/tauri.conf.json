{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claw Proxy",
  "version": "0.1.0",
  "identifier": "io.clawproxy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "main",
        "title": "Claw Proxy",
        "width": 400,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/claw-proxy-x86_64-apple-darwin",
      "binaries/claw-proxy-aarch64-apple-darwin"
    ]
  }
}